<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="theme-color" content="#2b2522" />
    <title>Flip the Mobile</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700;9..40,800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="css/styles.css" />
  </head>
  <body>
    {{!--
      MAIN PAGE TEMPLATE
      - Questions come from questions.json  →  {{#each questions}} below
      - Images live in /img                 →  src="img/{{before}}"
      - `npm run dev` / `npm run build` turn this file into dist/index.html
    --}}
    <main id="app">
      {{!-- ============ 1. ATTRACT: "Tap anywhere to begin" ============ --}}
      <section id="screen-attract" class="screen screen--attract is-active" aria-labelledby="attract-title">
        <div class="hero">
          <h1 id="attract-title" class="hero__title">Is your CMPA knowledge ahead of what comes next?</h1>
          <p class="hero__subtitle">or is the risk of future allergic manifestations going unrecognized?</p>
        </div>
        <p class="tap-cta">
          <span class="tap-cta__icon" aria-hidden="true">☝</span>
          <span>Tap anywhere to begin</span>
        </p>
      </section>

      {{!-- ============ 2. HOME: the mobile ============ --}}
      <section id="screen-home" class="screen screen--home" aria-labelledby="home-title">
        <div id="scene" class="scene">
          <div class="hero">
            <h1 id="home-title" class="hero__title hero__title--flip"><strong>FLIP</strong> <span>THE MOBILE</span></h1>
            <p class="hero__subtitle">Can you flip their CMPA story?</p>
          </div>

          <div class="ornaments">
            {{#each questions}}
              <button
                class="ornament"
                type="button"
                data-id="{{id}}"
                style="--x: {{x}}%; --y: {{y}}%"
                aria-label="{{label}}"
              >
                <span class="ornament__string" aria-hidden="true"></span>
                <span class="ornament__inner">
                  <img class="ornament__before" src="img/{{before}}" alt="" draggable="false" />
                  <img class="ornament__after" src="img/{{after}}" alt="" draggable="false" />
                </span>
              </button>
            {{/each}}
          </div>

          <p class="tap-cta">
            <span class="tap-cta__icon" aria-hidden="true">☝</span>
            <span>Tap an ornament to reveal a question</span>
          </p>
        </div>
        <footer class="footer"><button class="footer__button js-return" type="button">↺&nbsp;&nbsp;Return to start</button></footer>
      </section>

      {{!-- ============ 3. QUESTIONS — one <article> per question in questions.json ============ --}}
      <section id="screen-question" class="screen screen--question">
        <div class="progress" role="group" aria-label="Progress">
          <div class="progress__labels">
            <span class="js-progress-count">0/{{total}}</span>
            <span class="js-progress-pct">0% Complete</span>
          </div>
          <div class="progress__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="progress__fill"></div>
          </div>
        </div>

        {{#each questions}}
          <article class="question" data-id="{{id}}" data-correct="{{correctIndex}}" hidden>
            <figure class="question__figure">
              <img class="question__image question__image--before" src="img/{{before}}" alt="" />
              <img
                class="question__image question__image--after"
                src="img/{{after}}"
                {{#if incorrectImage}}data-incorrect-src="img/{{incorrectImage}}"{{/if}}
                alt=""
              />
            </figure>

            <div class="card" aria-live="polite">
              <h2 class="card__question">{{question}}</h2>

              {{!-- before answering --}}
              <div class="ask">
                <p class="ask__prompt">Select an answer below:</p>
                <div class="answers">
                  {{#each answers}}
                    <button class="pill pill--choice" type="button" data-index="{{@index}}">{{letter}}. {{text}}</button>
                  {{/each}}
                </div>
              </div>

              {{!-- after answering --}}
              <div class="result" hidden>
                <div class="result__pair">
                  <div>
                    <p class="result__label">Your answer:</p>
                    <div class="pill js-your-answer"></div>
                  </div>
                  <div>
                    <p class="result__label">Correct answer:</p>
                    <div class="pill pill--correct">{{correctAnswer.letter}}. {{correctAnswer.text}}</div>
                  </div>
                </div>
                <div class="feedback">
                  <p class="feedback__title feedback__title--correct">Your answer is correct!</p>
                  <p class="feedback__title feedback__title--incorrect">Your answer is incorrect!</p>
                  <p class="feedback__info">{{info}}</p>
                </div>
                <button class="next-button js-next" type="button">
                  <span class="next-button__more">Select another ornament</span>
                  <span class="next-button__finish">See my score</span>
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>
          </article>
        {{/each}}

        <footer class="footer"><button class="footer__button js-return" type="button">↺&nbsp;&nbsp;Return to start</button></footer>
      </section>

      {{!-- ============ 4. END: score + QR ============ --}}
      <section id="screen-end" class="screen screen--end" aria-labelledby="end-title">
        <div class="hero">
          <h1 id="end-title" class="hero__title">Congratulations!</h1>
          <p class="hero__subtitle hero__subtitle--score">You have scored a <span class="js-score">0</span>/{{total}}.</p>
        </div>
        <div class="end-card">
          <img class="end-card__qr" src="img/qr-code.svg" alt="QR code — scan to share your score" />
          <div class="end-card__copy">
            <p class="end-card__small">Keep learning to support your CMPA patients.</p>
            <h2 class="end-card__heading">Share your score!</h2>
            <p class="end-card__small">Challenge other HCPs and see who knows CMPA best.</p>
            <p class="end-card__small end-card__hashtag">#FlipthemobileCMPA</p>
          </div>
        </div>
        <footer class="footer">
          <button class="footer__button js-return" type="button">✕&nbsp;&nbsp;Exit and return to start</button>
        </footer>
      </section>
    </main>

    {{!-- ============ IDLE POPUP (timings in js/config.js) ============ --}}
    <div id="idle-modal" class="modal" hidden>
      <div class="modal__dialog" role="alertdialog" aria-modal="true" aria-labelledby="idle-question">
        <button class="modal__close js-keep-playing" type="button" aria-label="Close and keep playing">✕</button>
        <p class="modal__heading">Keep playing to flip the mobile and learn more about CMPA.</p>
        <p class="modal__body">Lorem ipsum dolor sit amet</p>
        <h2 id="idle-question" class="modal__question">Are you still there?</h2>
        <button class="outline-button js-keep-playing" type="button">Yes, keep playing</button>
      </div>
    </div>

    {{!-- GSAP (copied from node_modules at build time) then the game --}}
    <script src="js/vendor/gsap.min.js"></script>
    <script type="module" src="js/app.js"></script>
  </body>
</html>

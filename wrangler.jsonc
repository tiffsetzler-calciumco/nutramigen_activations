{
  // Cloudflare Workers config — serves the built ./dist folder as a static site.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutramigen-activations",
  "compatibility_date": "2026-10-01",
  // Public URL: https://nutramigen-activations.<account-subdomain>.workers.dev
  "workers_dev": true,
  // Each branch / pull request gets its own preview URL.
  "preview_urls": true,
  // `wrangler deploy` (and Cloudflare's auto-deploy) runs this first: compiles SCSS + copies src/ → dist/.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
